# systemd unit for the Command History syslog receiver (manage.py syslog_receive).
# Installed by deploy/maintenance/enable_syslog.sh (also run by install.sh); User, WorkingDirectory and ExecStart are
# filled in there. It runs as the app's own user: CAP_NET_BIND_SERVICE lets it use UDP 514 without root.
[Unit]
Description=VAULT syslog receiver (Command History)
After=network.target mysql.service mariadb.service

[Service]
User=vault
Group=vault
WorkingDirectory=/opt/vault
ExecStart=/opt/vault/.venv/bin/python manage.py syslog_receive
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
